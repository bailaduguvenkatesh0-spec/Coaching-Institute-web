{
  "name": "15 Parent Message Approval and Dispatch",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf-15-trigger",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook Inbound",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "id": "node-trigger-15"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json != null }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Validate Payload & Idempotency",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        480,
        300
      ],
      "id": "node-val-15"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:4000/api/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-n8n-secret",
              "value": "={{ $env.N8N_SHARED_WEBHOOK_SECRET || \"teamb-n8n-shared-secret-demo\" }}"
            },
            {
              "name": "x-idempotency-key",
              "value": "=idem-n8n-{{ $json.idempotencyKey || Date.now() }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 10000,
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 1000
          }
        }
      },
      "name": "Call API Endpoint (Bounded Retry)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        720,
        240
      ],
      "id": "node-http-15"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:4000/api/automation/runs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-n8n-secret",
              "value": "={{ $env.N8N_SHARED_WEBHOOK_SECRET || \"teamb-n8n-shared-secret-demo\" }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"workflowName\":\"15 Parent Message Approval and Dispatch\",\"status\":\"SUCCESS\",\"details\":{\"workflowId\":\"15\"}}"
      },
      "name": "Log Execution Outcome",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        950,
        240
      ],
      "id": "node-log-15"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:4000/api/automation/runs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-n8n-secret",
              "value": "={{ $env.N8N_SHARED_WEBHOOK_SECRET || \"teamb-n8n-shared-secret-demo\" }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"workflowName\":\"15 Parent Message Approval and Dispatch\",\"status\":\"FAILED\",\"details\":{\"error\":\"Payload validation or downstream HTTP execution failure\"}}"
      },
      "name": "Error Branch & Recovery Log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        720,
        420
      ],
      "id": "node-err-15"
    }
  ],
  "connections": {
    "Webhook Inbound": {
      "main": [
        [
          {
            "node": "Validate Payload & Idempotency",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Payload & Idempotency": {
      "main": [
        [
          {
            "node": "Call API Endpoint (Bounded Retry)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Error Branch & Recovery Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call API Endpoint (Bounded Retry)": {
      "main": [
        [
          {
            "node": "Log Execution Outcome",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "saveExecutionProgress": true,
    "saveManualExecutions": true
  },
  "tags": [
    {
      "name": "TEAM-B"
    },
    {
      "name": "ACADEMIC"
    }
  ]
}