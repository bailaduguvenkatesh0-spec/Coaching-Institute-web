# TEAM B COACHING INSTITUTE - ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy to .env for local runtime. DO NOT commit actual secrets.

# Application Environment
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173
# Local Vite proxy target. Set VITE_API_URL on the frontend build for cloud deployment.
API_URL=http://127.0.0.1:4000
VITE_API_URL=
APP_TIMEZONE=Asia/Kolkata

# Security & Authentication
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-chars-long
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-a-secure-cookie-secret

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teamb_db?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=teamb_db
POSTGRES_PORT=5432

# n8n Automation Configuration
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_WEBHOOK_SECRET=replace-with-shared-secret-for-webhook-verification
N8N_SHARED_WEBHOOK_SECRET=replace-with-shared-secret-for-webhook-verification
N8N_ENCRYPTION_KEY=replace-with-secure-32-char-key

# AI Assistant (Optional / Demo fallback mode enabled by default)
# LLM_PROVIDER can be 'openai' | 'anthropic' | 'gemini' | 'mock'
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Email Provider Configuration (Safe DEMO MODE by default)
# EMAIL_PROVIDER can be 'demo' | 'smtp' | 'sendgrid' | 'ses'
EMAIL_PROVIDER=demo
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=admissions@teamb.edu

# Mock Communication Services (Safe Demo Mode)
MOCK_SMS_ENABLED=true
MOCK_WHATSAPP_ENABLED=true
MOCK_EMAIL_ENABLED=true

# Demo Seed Settings
SEED_DEMO_ACCOUNTS=true
ALLOW_DEV_RESET=true
